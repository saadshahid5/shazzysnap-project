# Flutter Downloader
-keep class vn.hunghd.** { *; }
-keep class io.flutter.** { *; }

# Firebase
-keep class com.google.firebase.** { *; }
-keep class com.google.android.gms.** { *; }

# SQLite
-keep class org.sqlite.** { *; }

# Keep model classes
-keep class com.shazzysnap.** { *; }

# Kotlin
-keep class kotlin.** { *; }
-keep class kotlinx.** { *; }

# Suppress warnings
-dontwarn com.google.android.gms.**
-dontwarn okhttp3.**
